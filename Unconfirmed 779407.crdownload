     "output_type": "stream",
     "text": [
      "Overwriting app.py\n"
     ]
    }
   ],
   "source": [
    "%%writefile app.py\n",
    "\n",
    "import streamlit as st\n",
    "\n",
    "st.title(\"Smart Jacket Monitoring System\")\n",
    "\n",
    "st.subheader(\"Underground Miner Monitoring\")\n",
    "\n",
    "st.write(\"Welcome to the Smart Jacket Dashboard!\")\n",
    "\n",
    "st.metric(\n",
    "    label=\"PIR Sensor Status\",\n",
    "    value=\"NO MOVEMENT\"\n",
    ")\n",
    "\n",
    "st.success(\"System is running.\")"
   ]
  },
